<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xmlns:secure="http://www.springframework.org/schema/security"
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:mvc="http://www.springframework.org/schema/mvc" 
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:tx="http://www.springframework.org/schema/tx"
	xsi:schemaLocation="
		http://www.springframework.org/schema/mvc lib/xsd/spring-mvc-4.2.xsd 
		http://www.springframework.org/schema/beans lib/xsd/spring-beans-4.2.xsd
		http://www.springframework.org/schema/context lib/xsd/spring-context-4.2.xsd
		http://www.springframework.org/schema/tx lib/xsd/spring-tx-4.2.xsd
		http://www.springframework.org/schema/security lib/xsd/spring-security-4.0.xsd">

	<context:component-scan base-package="digital.places.root" />

	<bean id="util" class="digital.places.root.AppUtils">
		<property name="dataSource" ref="dataSource"/>
	</bean>
	<bean id="dataSource" class="org.springframework.jndi.JndiObjectFactoryBean">
		<property name="jndiName" value="java:comp/env/jdbc/userie"/>
	</bean>

	<bean id="appContextJavaProvider"
    	class="digital.places.root.AppContextJavaProvider"/>
                        
    <!-- enable use-expressions -->
	<secure:http auto-config="true" use-expressions="true">
		
		<secure:intercept-url pattern="/*" access="hasAnyRole('ROLE_ADDER','ROLE_ADMIN','ROLE_USER','ROLE_GUEST','ROLE_VENDOR','ROLE_DEFAULT')" />
		<secure:intercept-url pattern="/user/add*" access="hasRole('ROLE_ADDER')" />
		<secure:intercept-url pattern="/user/viewall*" access="hasAnyRole('ROLE_ADDER','ROLE_ADMIN')" />
		<secure:intercept-url pattern="/user/search*" access="hasRole('ROLE_ADDER')" />
		<secure:intercept-url pattern="/user/update*" access="hasAnyRole('ROLE_ADDER','ROLE_ADMIN')" />
		<secure:intercept-url pattern="/role/add*" access="hasRole('ROLE_ADDER')" />
		<secure:intercept-url pattern="/role/viewall*" access="hasAnyRole('ROLE_ADDER','ROLE_ADMIN')" />
		<!-- access denied page -->
		<secure:access-denied-handler error-page="/o/403" />
		
		<secure:form-login 
		    login-page="/o/login" 
		    default-target-url="/user/viewall" 
		    login-processing-url="/o/j_spring_security_check"
			authentication-failure-url="/o/login?error" 
			username-parameter="username"
			password-parameter="password" />
		<secure:logout logout-success-url="/o/login?logout" logout-url="/o/j_spring_security_logout" />
		<!-- enable csrf protection -->
		<secure:csrf/>
	</secure:http>
	
	<!-- Select users and user_roles from database -->
	<secure:authentication-manager>
	  <secure:authentication-provider>
	  	  <secure:jdbc-user-service data-source-ref="dataSource"
		  users-by-username-query=
		    "select username,password, enabled from users where username=?"
		  authorities-by-username-query=
		    "select user_roles.username, roles.role as authorities from roles,user_roles where user_roles.username =? and user_roles.roleid = roles.roleid" />
	  </secure:authentication-provider>
	</secure:authentication-manager>

    <bean id="entityManagerFactoryBean" class="org.springframework.orm.jpa.LocalContainerEntityManagerFactoryBean">
      <property name="dataSource" ref="dataSource" />
      <property name="packagesToScan">
        <list>
              <value>digital.places.user</value>
              <value>digital.places.role</value>
         </list>
      </property>   
      <property name="jpaVendorAdapter">
         <bean class="org.springframework.orm.jpa.vendor.HibernateJpaVendorAdapter" />
      </property>
      <property name="jpaProperties">
         <props>
            <prop key="hibernate.hbm2ddl.auto">validate</prop>
            <!-- <prop key="hibernate.hbm2ddl.auto">create-drop</prop> -->
            <prop key="hibernate.show_sql">true</prop>
            <prop key="hibernate.dialect">org.hibernate.dialect.MySQL5Dialect</prop>
         </props>
      </property>
   </bean>
   
    <bean id="transactionManager" class="org.springframework.orm.jpa.JpaTransactionManager">
      <property name="entityManagerFactory" ref="entityManagerFactoryBean" />
   </bean>
    
   	<bean id="dataStore" class="digital.places.root.DataStore" />
   	<bean id="dataService" class="digital.places.root.DataService" />
   	
  <!--    <bean id="persistenceExceptionTranslationPostProcessor"
      class="org.springframework.dao.annotation.PersistenceExceptionTranslationPostProcessor" /> --> 
   <tx:annotation-driven />
</beans>
